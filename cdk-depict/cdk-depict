#!/bin/sh
set -eu
prefix=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ "${1:-}" = "--serve" ]; then
    shift
    exec "$prefix/bin/cdk-depict-web" "$@"
fi
if [ "${1:-}" = "--help" ]; then
    printf '%s\n' 'Web mode: cdk-depict --serve [Spring Boot options]'
fi
exec "$prefix/bin/java" -Djava.awt.headless=true -cp "$prefix/share/cdk-depict/cli:$prefix/share/cdk-depict/lib/*" org.openscience.cdk.app.DepictCli "$@"
